# Copy to .env (which is git-ignored) and fill in. Never commit the real token.
DISCORD_TOKEN=
# Optional: your test server's ID. Commands now sync globally (so they work in DMs);
# if set, the old per-server copy of the commands is removed so nothing shows twice.
DISCORD_GUILD_ID=
# Optional: where to keep the SQLite database
MORTAL_DB_PATH=mortal_ascent.db
# Optional: Discord user IDs allowed to use /admin (comma-separated). The bot's owner always can.
ADMIN_IDS=

# --- Website (python -m web), see docs/web.md ---
# Discord Developer Portal > your app > OAuth2. Never commit or share the secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must also be added under OAuth2 > Redirects. Change it to your real address when the site goes online.
WEB_REDIRECT_URI=http://localhost:8000/callback
# Any long random text. Keeps players logged in when the website restarts.
WEB_SESSION_SECRET=
